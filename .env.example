# 4. GMAIL SMTP SECURE OUTREACH TRANSPORT
# Standard 16-character Google App Password (not your personal Google account password)
GMAIL_EMAIL=your_export_sales_email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 5. BUSINESS PARAMETERS & RUNTIME SAFEGUARDS
SEARCH_KEYWORD=Himalayan Sound Healing Bowls
